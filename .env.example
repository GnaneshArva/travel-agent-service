# App Settings
APP_NAME=travel-agent-service
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI Agent Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096
AGENT_RETRY_COUNT=3

# MCP Endpoints
TRAVEL_MCP_URL=http://localhost:8001
MEMORY_MCP_URL=http://localhost:8002
KNOWLEDGE_MCP_URL=http://localhost:8003
GUARDRAILS_SERVICE_URL=http://localhost:8004
PROMPT_MANAGEMENT_URL=http://localhost:8005
OBSERVABILITY_SERVICE_URL=http://localhost:8006

# Feature Flags
ENABLE_MEMORY=true
ENABLE_KNOWLEDGE=true
ENABLE_GUARDRAILS=true
ENABLE_OBSERVABILITY=true
ENABLE_PROMPT_MANAGEMENT=true
ENABLE_STREAMING=true
ENABLE_PLANNING=true

# Timeouts & Retries (in seconds)
TOOL_TIMEOUT=15.0
MCP_TIMEOUT=10.0
AGENT_TIMEOUT=60.0
DEFAULT_RETRY_ATTEMPTS=3
